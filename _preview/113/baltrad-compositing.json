\ngenerator.filenames = glob.glob(\"data/se*.h5\")","key":"aw1yMOOVeE"},{"type":"output","id":"0keXKp2xUU_m-PnqrL9bW","data":[],"key":"Mhan9us27s"}],"key":"wdHqJgGTlg"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2024-12-03T00:25:54.319308Z","iopub.status.busy":"2024-12-03T00:25:54.318856Z","iopub.status.idle":"2024-12-03T00:26:05.761405Z","shell.execute_reply":"2024-12-03T00:26:05.760919Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Run with all defaults to a pre-configured area that uses the Google Maps projection.\n# First two arguments are product date and time. These are taken from the last input file if not specified.\nbefore = time.time()\ncomp = generator.generate(None, None, area=\"swegmaps_2000\")\nafter = time.time()\n\nrio = _raveio.new()\nrio.object = comp\nrio.save(\"data/comp_pcappi1000m.h5\")\n\nprint(\"Compositing took %3.2f seconds\" % (after - before))","key":"jps1uNZOTI"},{"type":"output","id":"KF5T7J2lQI80DK4bEc-Hh","data":[{"name":"stdout","output_type":"stream","text":"Compositing took 11.41 seconds\n"}],"key":"hU0K7I4ozA"}],"key":"jF3iwnDgDw"},{"type":"block","kind":"notebook-content","data":{},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Tweak the plotter from earlier exercises","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ddDNNqLXyJ"}],"identifier":"tweak-the-plotter-from-earlier-exercises","label":"Tweak the plotter from earlier exercises","html_id":"tweak-the-plotter-from-earlier-exercises","implicit":true,"key":"I9i9KnMfWm"}],"key":"rv02Wwkmsi"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2024-12-03T00:26:05.763418Z","iopub.status.busy":"2024-12-03T00:26:05.763219Z","iopub.status.idle":"2024-12-03T00:26:05.768793Z","shell.execute_reply":"2024-12-03T00:26:05.768397Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Two color palettes, one used in GoogleMapsPlugin, and the other from RAVE\nfrom GmapColorMap import dbzh as dbzp\n\n\n# Convert a 768-list palette to a matplotlib colorlist\ndef make_colorlist(pal):\n    colorlist = []\n    for i in range(0, len(pal), 3):\n        colorlist.append([pal[i] / 255.0, pal[i + 1] / 255.0, pal[i + 2] / 255.0])\n    return colorlist\n\n\n# Convert lists to colormaps\ndbzcl = make_colorlist(dbzp)\n\n# Then create a simple plotter\nimport matplotlib.pyplot as plt\n\nStringType = type(\"\")\n\n\ndef plot(data, colorlist=dbzcl, title=\"Composite\"):\n    mini, maxi = data.shape.index(min(data.shape)), data.shape.index(max(data.shape))\n    figsize = (20, 16)  # if mini == 0 else (12,8)\n    fig = plt.figure(figsize=figsize)\n    plt.title(title)\n    clist = (\n        colorlist\n        if type(colorlist) == StringType\n        else matplotlib.colors.ListedColormap(colorlist)\n    )\n    plt.imshow(data, cmap=clist, clim=(0, 255))\n    plt.colorbar(shrink=float(data.shape[mini]) / data.shape[maxi])","key":"gIZ2ENedAP"},{"type":"output","id":"dV5hmUk9n-r8WGreiUQEc","data":[],"key":"Et6GzRjHt9"}],"key":"cwTw4J1pEX"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2024-12-03T00:26:05.770780Z","iopub.status.busy":"2024-12-03T00:26:05.770398Z","iopub.status.idle":"2024-12-03T00:26:06.184147Z","shell.execute_reply":"2024-12-03T00:26:06.183600Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"plot(\n    comp.getParameter(\"DBZH\").getData(),\n    title=\"Default composite: DBZH 1000 m Pseudo-CAPPI, nearest radar\",\n)","key":"vAWcN5ncWP"},{"type":"output","id":"NtfoKn9BdJVaGiWFSpMPF","data":[{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"14a1907a7fc7bbc7097bf4cad6bfe855","path":"/erad2024/_preview/113/build/14a1907a7fc7bbc7097bf4cad6bfe855.png"},"text/plain":{"content":"<Figure size 2000x1600 with 2