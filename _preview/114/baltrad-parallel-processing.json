":"notebook-content","data":{},"children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Yay! Now we’re going to set up some rudimentary functionality that will allow us to distribute a processing load among our cores.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TYN6H3gwXt"}],"key":"kltMz1jK4E"}],"key":"ock26PXW2g"},{"type":"block","kind":"notebook-content","data":{},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Define a generator","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Rte0b5A2ZG"}],"identifier":"define-a-generator","label":"Define a generator","html_id":"define-a-generator","implicit":true,"key":"CEjN8vP0yU"}],"key":"XGh6YrDWWG"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2025-01-27T23:58:54.348664Z","iopub.status.busy":"2025-01-27T23:58:54.348502Z","iopub.status.idle":"2025-01-27T23:58:54.439730Z","shell.execute_reply":"2025-01-27T23:58:54.439172Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import os\nimport _raveio, odc_polarQC\n\n# Specify the processing chain\nodc_polarQC.algorithm_ids = [\n    \"ropo\",\n    \"beamb\",\n    \"radvol-att\",\n    \"radvol-broad\",\n    \"rave-overshooting\",\n    \"qi-total\",\n]\n\n\n# Run processing chain on a single file. Return an output file string.\ndef generate(file_string):\n    rio = _raveio.open(file_string)\n\n    pvol = rio.object\n    pvol = odc_polarQC.QC(pvol)\n    rio.object = pvol\n\n    # Derive an output file name\n    path, fstr = os.path.split(file_string)\n    ofstr = os.path.join(path, \"qc_\" + fstr)\n\n    rio.save(ofstr)\n    return ofstr","key":"Uv9tDS2Tdq"},{"type":"output","id":"0ABormuRPxhiEViZQRWuz","data":[],"key":"KVaD7BQPpK"}],"key":"YXGOWLA5JU"},{"type":"block","kind":"notebook-content","data":{},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Feed the generator, sequentially","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BKpJokputM"}],"identifier":"feed-the-generator-sequentially","label":"Feed the generator, sequentially","html_id":"feed-the-generator-sequentially","implicit":true,"key":"iNELyG7kzv"}],"key":"FJ910zcIEz"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2025-01-27T23:58:54.442191Z","iopub.status.busy":"2025-01-27T23:58:54.441943Z","iopub.status.idle":"2025-01-27T23:59:45.031090Z","shell.execute_reply":"2025-01-27T23:59:45.030467Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import glob, time\n\nifstrs = glob.glob(\"data/se*.h5\")\nbefore = time.time()\nfor fstr in ifstrs:\n    print(fstr, generate(fstr))\nafter = time.time()\n\nprint(\"Processing time: %3.2f seconds\" % (after - before))","key":"sBW3mj9tav"},{"type":"output","id":"dJq03vvYYfoJHUk4ivrmI","data":[{"name":"stdout","output_type":"stream","text":"data/searl.h5 data/qc_searl.h5\n"},{"name":"stdout","output_type":"stream","text":"data/sehud.h5 data/qc_sehud.h5\n"},{"name":"stdout","output_type":"stream","text":"data/sekir.h5 data/qc_sekir.h5\n"},{"name":"stdout","output_type":"stream","text":"data/sekkr.h5 data/qc_sekkr.h5\n"},{"name":"stdout","output_type":"stream","text":"data/seosu.h5 data/qc_seosu.h5\n"},{"name":"stdout","output_type":"stream","text":"data/selek.h5 data/qc_selek.h5\n"},{"name":"stdout","output_type":"stream","text":"data/sevar.h5 data/qc_sevar.h5\n"},{"name":"stdout","output_type":"stream","text":"data/seang.h5 data/qc_seang.h5\n"},{"name":"stdout","output_type":"stream","text":"data/sease.h5 data/qc_sease.h5\n"},{"name":"stdout","output_type":"stream","text":"data/sevil.h5 data/qc_sevil.h5\n"},{"name":"stdout","output_type":"stream","text":"data/selul.h5 data/qc_selul.h5\nProcessing time: 50.58 seconds\n"}],"key":"NjiAtbklM6"}],"key":"K8m5QVuxd9"},{"type":"block","kind":"notebook-content","data":{},"children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Mental note: repeat once!","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XFddVeYxqi"}],"key":"OMWfs8NHV2"}],"key":"e4GyASWKVD"},{"type":"block","kind":"notebook-content","data":{},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Multiprocess the generator","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"V9UmeHQynR"}],"identifier":"multiprocess-the-generator","label":"Multiprocess the generator","html_id":"multiprocess-the-generator","implicit":true,"key":"JmZFr8aCGH"}],"key":"oA6r5gAylH"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2025-01-27T23:59:45.033586Z","iopub.status.busy":"2025-01-27T23:59:45.033168Z","iopub.status.idle":"2025-01-27T23:59:45.037303Z","shell.execute_reply":"2025-01-27T23:59:45.036783Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Both input and output are a list of file strings\ndef multi_generate(fstrs, procs=None):\n    pool = multiprocessing.Pool(\n        procs\n    )  # Pool of processors. Defaults to all available logical cores\n\n    results = []\n    # chunksize=1 means feed a process a new job as soon as the process is idle.\n    # In our case, this restricts the queue to one \"dispatcher\" which is faster.\n    r = pool.map_async(generate, fstrs, chunksize=1, callback=results.append)\n    r.wait()\n\n    return results[0]","key":"EqF8zvbibe"},{"type":"output","id":"-jCim4Sb2lu9et8MOKTEK","data":[],"key":"wRQBpZBp45"}],"key":"mGmVuRlk4q"},{"type":"block","kind":"notebook-content","data":{},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Feed the monster, asynchronously!","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"m3vMBAKwvC"}],"identifier":"feed-the-monster-asynchronously","label":"Feed the monster, asynchronously!","html_id":"feed-the-monster-asynchronously","implicit":true,"key":"iD2FE7gRPK"}],"key":"uG5dnieXGr"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2025-01-27T23:59:45.039145Z","iopub.status.busy":"2025-01-27T23:59:45.038980Z","iopub.status.idle":"2025-01-27T23:59:48.212020Z","shell.execute_reply":"2025-01-27T23:59:48.211310Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"before = time.time()\nofstrs = multi_generate(ifstrs)\nafter = time.time()\n\nprint(\"Processing time: %3.2f seconds\" % (after - before))","key":"l3I65HG3d4"},{"type":"output","id":"uMADyIGaIvWzhtpBfBfdw","data":[{"name":"stdout","output_type":"stream","text":"Processing time: 3.17 seconds\n"}],"key":"QQWtENZfOP"}],"key":"wUVe2r75SA"}],"key":"AZ2fBi8YOm"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Quality Control using DR","url":"/baltrad-drqc","group":"BALTRAD"},"next":{"title":"Compositing","url":"/baltrad-compositing","group":"BALTRAD"}}},"domain":"http://localhost:3000"}